      "link": null,
      "locked": false,
      "text": "Solid = request path · Dashed = approval, storage, live updates · Only the Validator can mark a task done; an agent saying 'done' is never trusted",
      "originalText": "Solid = request path · Dashed = approval, storage, live updates · Only the Validator can mark a task done; an agent saying 'done' is never trusted",
