    {
      "id": "te63",
      "type": "text",
      "x": 20,
      "y": 872,
      "width": 833.2800000000001,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
