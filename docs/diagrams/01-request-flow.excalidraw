      "seed": 1179913225,
      "version": 2,
      "versionNonce": 1815665591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793078598902,
      "link": null,
      "locked": false,
      "text": "6a Worker calls the LLM through the Model Gateway (usage is metered)\n6b Worker calls tools; GitHub access goes through the broker, never via prompts\n7 Every call is recorded as a step, hash-chained into one receipt and saved\n8 Validator reads the Φ result the enclave recorded; with probability p it also audits\n9 Verdict goes to the Orchestrator; scores update only on an audit or a ruled challenge\n10 After human approval the PR is opened on GitHub · 11 live status streams to the requester",
      "originalText": "6a Worker calls the LLM through the Model Gateway (usage is metered)\n6b Worker calls tools; GitHub access goes through the broker, never via prompts\n7 Every call is recorded as a step, hash-chained into one receipt and saved\n8 Validator reads the Φ result the enclave recorded; with probability p it also audits\n9 Verdict goes to the Orchestrator; scores update only on an audit or a ruled challenge\n10 After human approval the PR is opened on GitHub · 11 live status streams to the requester",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
