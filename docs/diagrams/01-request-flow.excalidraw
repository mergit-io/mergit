      "seed": 964622594,
      "version": 2,
      "versionNonce": 320262745,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793078598902,
      "link": null,
      "locked": false,
      "text": "1 Requester submits a goal (web app, Slack or a GitHub issue)\n2 API Gateway checks login, tenant and rate limits\n3 Orchestrator asks the Planner to split the goal into tasks, each with a pass/fail check\n4 The requester reviews and approves the plan, so each check is theirs\n5 Orchestrator sends each ready task to the Router\n6 Requester picks the agent (Thompson sampling on success per cost from P4); a worker runs it",
      "originalText": "1 Requester submits a goal (web app, Slack or a GitHub issue)\n2 API Gateway checks login, tenant and rate limits\n3 Orchestrator asks the Planner to split the goal into tasks, each with a pass/fail check\n4 The requester reviews and approves the plan, so each check is theirs\n5 Orchestrator sends each ready task to the Router\n6 Requester picks the agent (Thompson sampling on success per cost from P4); a worker runs it",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0R"
    },
    {
      "id": "te64",
      "type": "text",
      "x": 995,
      "y": 872,
      "width": 824.32,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
