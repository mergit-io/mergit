# Copy to writer.env (git-ignored) and fill in. Never commit real values, never paste keys into chat.
ENS_MAINNET_RPC=https://your-ethereum-mainnet-rpc.example
# Needs eth_getLogs ranges larger than 200 blocks for a fast first backfill; the public https://sepolia.base.org allows only 200.
BASE_SEPOLIA_RPC=https://your-base-sepolia-rpc.example
# Two DIFFERENT accounts. The publisher holds mergit.reputation and mergit.operator; the editor holds agent-context and agent-endpoint[web].
ENS_PUBLISHER_PRIVATE_KEY=0x
ENS_EDITOR_PRIVATE_KEY=0x
WRITER_CONFIG=writer.json
# WRITER_PORT=8787
# WRITER_INTERVAL_SECONDS=300
# Caps on what the editor key can spend and on request volume (defaults shown):
# WRITER_EDITS_PER_AGENT_PER_HOUR=6
# WRITER_EDITS_PER_HOUR=60
# WRITER_REQUESTS_PER_MINUTE=120
