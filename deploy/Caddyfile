# Caddy for the Hetzner server (deploy/compose.server.yaml). Caddy gets and renews the HTTPS certificates itself;
# it needs the names below to resolve to this server first (see deploy/server/README.md).
#
# The sites are built by deploy/server/build-sites.sh into /srv/mergit/sites/{web,app}, mounted here as /srv.
# The validator is deliberately not exposed: only the gateway talks to it.
{
	email hello@mergit.site
}

(site_headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The apps use createBrowserRouter, so any unknown path must fall back to index.html.
	try_files {path} /index.html
}

# The public site: the design over mock data.
mergit.site {
	root * /srv/web
	import site_headers
	file_server
}

www.mergit.site {
	redir https://mergit.site{uri} permanent
}

# The API routes a browser calls. One list for app.mergit.site and api.mergit.site, so the two cannot drift;
# control-plane/tests/test_caddy_routes.py fails when a route in the API is missing from it.
(api_routes) {
	@api path /v0/auth/* /v0/account/* /v0/wallet-interest /v0/plans /v0/plans/* /v0/agents
}

# The same frontend on live Base Sepolia data, and the orchestration API on the same origin: the browser calls
# /v0/auth, /v0/account, /v0/wallet-interest, /v0/plans and /v0/agents here, so sign-in cookies are first-party and there is no CORS. The gateway and the
# worker reach the API directly over the compose network, so /v0/chain-events and /v0/internal are deliberately not
# proxied.
app.mergit.site {
	import api_routes
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		import site_headers
		file_server
	}
}

# Service APIs. Both allow any origin themselves (CORS), and their write endpoints need bearer tokens.
gateway.mergit.site {
	reverse_proxy gateway:8082
}

store.mergit.site {
	reverse_proxy store:8081
}

# The API on its own name. It serves the browser routes (api_routes) and /healthz, and the one route the agent worker
# calls from its own VM: /v0/internal/progress, only from the IP in WORKER_VM_IP (deploy/.env, passed in by
# compose.server.yaml; the default is a documentation address nothing can use). Everything else is 404: the
# gateway reaches /v0/chain-events over the compose network, and the API's own docs pages are not for the public.
# The worker's bearer token is still checked by the API; the IP rule only keeps the route off the open internet.
# Needs an A record for `api`. It sets its own CORS headers (CORS_ORIGINS) and a Secure, HttpOnly session cookie.
api.mergit.site {
	import api_routes
	@worker {
		path /v0/internal/*
		remote_ip {$WORKER_VM_IP:192.0.2.1}
	}
	handle @api {
		reverse_proxy api:8000
	}
	handle @worker {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle {
		respond "not found" 404
	}
}
