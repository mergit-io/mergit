# Caddy for the Hetzner server (deploy/compose.server.yaml). Caddy gets and renews the HTTPS certificates itself;
# it needs the names below to resolve to this server first (see deploy/server/README.md).
#
# The sites are built by deploy/server/build-sites.sh into /srv/mergit/sites/{web,app}, mounted here as /srv.
# The validator is deliberately not exposed: only the gateway talks to it.
{
	email hello@mergit.site
}

(site_headers) {
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The page itself is never cached: a new deploy has new asset names, and a stale index.html would point at old ones.
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"
	# Report-only: it shows in the browser console what would be blocked, without blocking. Watch it on a deployed
	# page (sign in, open a run, the wallet picker) and fix every violation before turning it into an enforcing
	# Content-Security-Policy. Enforcing it blind could break sign-in or the wallet. Clickjacking is covered
	# already by X-Frame-Options below.
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://gateway.mergit.site https://store.mergit.site https://sepolia.base.org https://api.github.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	# The app is a single-page app, so its own routes fall back to index.html. Anything else that is not a file is a
	# real 404 (not the app shell with a 200, which scanners flag and search engines index as soft 404s).
	@spa path / /signin /signin/* /demo /demo/* /app /app/*
	rewrite @spa /index.html
}

# The API routes a browser calls. One list for the site (mergit.site and app.mergit.site) and api.mergit.site, so the
# two cannot drift; control-plane/tests/test_caddy_routes.py fails when a route in the API is missing from it.
# The bare /v0/account is not listed on purpose: it is DELETE /v0/account, deleting the account. It stays off the public
# origin until the gaps in what a deletion removes and in the once-per-person free credits are decided (see
# accounts.delete_account). /v0/account/* is every other account route.
(api_routes) {
	@api path /v0/auth/* /v0/account/* /v0/wallet-interest /v0/plans /v0/plans/* /v0/agents /v0/agents/*
}

# The site: the frontend on live Base Sepolia data, and the orchestration API on the same origin. It is served on both
# mergit.site and app.mergit.site, identically. Each page calls /v0/auth, /v0/account, /v0/wallet-interest, /v0/plans
# and /v0/agents (with its /reputation) on its own hostname, so there is no CORS. The gateway and the worker reach the API directly over the
# compose network, so /v0/chain-events and /v0/internal are deliberately not proxied.
# deploy/secrets/api.env must say how sign-in works across the two: APP_DOMAIN=app.mergit.site (where GitHub and Google
# send people back to, since each allows one callback address), EXTRA_DOMAINS=mergit.site (wallet sign-in is accepted
# from both) and COOKIE_DOMAIN=mergit.site (the session cookie is shared, so signing in on one signs in on the other).
mergit.site, app.mergit.site {
	import api_routes
	# On every response, the page's and the API's. HSTS has no includeSubDomains or preload: other names under this
	# domain are not all known to be HTTPS-only, and a preload entry cannot be taken back quickly.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		import site_headers
		file_server
	}
}

www.mergit.site {
	redir https://mergit.site{uri} permanent
}

# Service APIs. Both allow any origin themselves (CORS), and their write endpoints need bearer tokens.
gateway.mergit.site {
	reverse_proxy gateway:8082
}

store.mergit.site {
	reverse_proxy store:8081
}

# The API on its own name. It serves the browser routes (api_routes) and /healthz, and the one route the agent worker
# calls from its own VM: /v0/internal/progress, only from the IP in WORKER_VM_IP (deploy/.env, passed in by
# compose.server.yaml; the default is a documentation address nothing can use). Everything else is 404: the
# gateway reaches /v0/chain-events over the compose network, and the API's own docs pages are not for the public.
# The worker's bearer token is still checked by the API; the IP rule only keeps the route off the open internet.
# Needs an A record for `api`. It sets its own CORS headers (CORS_ORIGINS) and a Secure, HttpOnly session cookie.
api.mergit.site {
	import api_routes
	@worker {
		path /v0/internal/*
		remote_ip {$WORKER_VM_IP:192.0.2.1}
	}
	handle @api {
		reverse_proxy api:8000
	}
	handle @worker {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle {
		respond "not found" 404
	}
}
