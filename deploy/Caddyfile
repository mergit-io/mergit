# Caddy for the Hetzner server (deploy/compose.server.yaml). Caddy gets and renews the HTTPS certificates itself;
# it needs the names below to resolve to this server first (see deploy/server/README.md).
#
# The sites are built by deploy/server/build-sites.sh into /srv/mergit/sites/{web,app}, mounted here as /srv.
# The validator is deliberately not exposed: only the gateway talks to it.
{
	email hello@mergit.site
}

(site_headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The apps use createBrowserRouter, so any unknown path must fall back to index.html.
	try_files {path} /index.html
}

# The site: the frontend on live Base Sepolia data, and the orchestration API on the same origin. It is served on both
# mergit.site and app.mergit.site, identically. Each page calls /v0/auth, /v0/account, /v0/wallet-interest, /v0/plans
# and /v0/agents (with its /reputation) on its own hostname, so there is no CORS. The gateway and the worker reach the API directly over the
# compose network, so /v0/chain-events and /v0/internal are deliberately not proxied.
# deploy/secrets/api.env must say how sign-in works across the two: APP_DOMAIN=app.mergit.site (where GitHub and Google
# send people back to, since each allows one callback address), EXTRA_DOMAINS=mergit.site (wallet sign-in is accepted
# from both) and COOKIE_DOMAIN=mergit.site (the session cookie is shared, so signing in on one signs in on the other).
mergit.site, app.mergit.site {
	@api path /v0/auth/* /v0/account/* /v0/wallet-interest /v0/plans /v0/plans/* /v0/agents /v0/agents/*
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		import site_headers
		file_server
	}
}

www.mergit.site {
	redir https://mergit.site{uri} permanent
}

# Service APIs. Both allow any origin themselves (CORS), and their write endpoints need bearer tokens.
gateway.mergit.site {
	reverse_proxy gateway:8082
}

store.mergit.site {
	reverse_proxy store:8081
}

# The same API on its own name, for anything that is not the web app. Optional: the site uses its own hostnames above.
# Needs an A record for `api`. It sets its own CORS headers (CORS_ORIGINS) and a Secure, HttpOnly session cookie.
api.mergit.site {
	reverse_proxy api:8000
}
