# Copy to worker.env on the worker VM (chmod 600) and fill in. Never commit worker.env.
# Names only here; the values come from the server's deploy/secrets/*.env and from your model provider.

# A fixed name, ONE PER PROCESS. The worker finds, fails and cleans up what its previous run left by this name, and
# refuses to start if another process already holds it. Never reuse a name for a second worker on the same database.
WORKER_ID=worker-vm-1

# Printed once by deploy/worker-vm/create-db-role.sh on the server. Use the server's PRIVATE address.
DATABASE_URL=postgres://mergit_worker:CHANGE-ME@10.0.0.2:5433/mergit_cp?sslmode=prefer

# Same values as the server's deploy/secrets/worker.env (run `grep -E '^(EVENTS|STORE_WRITE|WORKER)_TOKEN' there`).
EVENTS_TOKEN=
STORE_WRITE_TOKEN=
WORKER_TOKEN=

# One key per agent in agents-base-sepolia.json, 0x plus 64 hex characters. The worker refuses to start without
# every one (REQUIRE_ALL_AGENT_KEYS in compose.yaml). From mergit-contracts/.env.services.
MERGIT_AGENT_KEY_1=

# A model key: Anthropic's, Groq's, or both. Anthropic is used when its key is present.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER=anthropic

# Optional. Only the pull-request gate needs it; without it the worker still runs tasks.
# GITHUB_TOKEN=

# Optional. gVisor, if runsc is installed on this VM. Untested here: leave unset unless you have tried it.
# SANDBOX_RUNTIME=runsc
